<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
 <event name="payment_method_is_active"><observer name="zyntrodata_availability" instance="Zyntrodata\Payments\Observer\Availability"/></event>
 <event name="payment_method_assign_data_zyntrodata"><observer name="zyntrodata_assign" instance="Zyntrodata\Payments\Observer\AssignData"/></event>
 <event name="sales_model_service_quote_submit_before"><observer name="zyntrodata_validate" instance="Zyntrodata\Payments\Observer\ValidateOrder"/></event>
 <event name="checkout_submit_all_after"><observer name="zyntrodata_submit" instance="Zyntrodata\Payments\Observer\SubmitOrder"/><observer name="zyntrodata_register_webhook" instance="Zyntrodata\Payments\Observer\RegisterWebhook"/></event>
</config>
